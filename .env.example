TARGET_SITE_URL=https://economictimes.indiatimes.com/tech
TARGET_RSS_URL=https://economictimes.indiatimes.com/tech/rssfeeds/13357270.cms
RAW_DIR=data/raw
RECORDS_DIR=data/records
CHROMA_DIR=data/chroma
COLLECTION_NAME=et_tech_articles
REQUEST_DELAY_SECONDS=1.5
REQUEST_TIMEOUT_SECONDS=20
MAX_ARTICLES=60
MIN_ARTICLES=55
USER_AGENT=NewsRAGPipeline/1.0 (+https://example.com/contact)

# Leave blank to use deterministic extraction and query answering.
# Never commit a real key to this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
CHUNK_SIZE_TOKENS=1200
CHUNK_OVERLAP_TOKENS=200
TOP_K=5
